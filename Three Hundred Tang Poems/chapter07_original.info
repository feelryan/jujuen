{
  "totalSectionNumber": 29,
  "sections": [
    {
      "sectionIndexOrName": "1",
      "original": [
        "鹿柴",
        "王維",
        "空山不見人，但聞人語響。",
        "返景入深林，復照青苔上。"
      ]
    },
    {
      "sectionIndexOrName": "2",
      "original": [
        "竹里館",
        "王維",
        "獨坐幽篁裏，彈琴復長嘯。",
        "深林人不知，明月來相照。"
      ]
    },
    {
      "sectionIndexOrName": "3",
      "original": [
        "送別",
        "王維",
        "山中相送罷，日暮掩柴扉。",
        "春草明年綠，王孫歸不歸。"
      ]
    },
    {
      "sectionIndexOrName": "4",
      "original": [
        "相思",
        "王維",
        "紅豆生南國，春來發幾枝。",
        "願君多采擷，此物最相思。"
      ]
    },
    {
      "sectionIndexOrName": "5",
      "original": [
        "雜詩",
        "王維",
        "君自故鄉來，應知故鄉事。",
        "來日綺窗前，寒梅著花未。"
      ]
    },
    {
      "sectionIndexOrName": "6",
      "original": [
        "送崔九 裴迪",
        "歸山深淺去，須盡丘壑美。",
        "莫學武陵人，暫遊桃源裏。"
      ]
    },
    {
      "sectionIndexOrName": "7",
      "original": [
        "終南望餘雪 祖詠",
        "終南陰嶺秀，積雪浮雲端。",
        "林表明霽色，城中增暮寒。"
      ]
    },
    {
      "sectionIndexOrName": "8",
      "original": [
        "宿建德江 孟浩然",
        "移舟泊煙渚，日暮客愁新。",
        "野曠天低樹，江清月近人。"
      ]
    },
    {
      "sectionIndexOrName": "9",
      "original": [
        "春曉 孟浩然",
        "春眠不覺曉，處處聞啼鳥。",
        "夜來風雨聲，花落知多少。"
      ]
    },
    {
      "sectionIndexOrName": "10",
      "original": [
        "靜夜思 李白",
        "床前明月光，疑是地上霜。",
        "舉頭望明月，低頭思故鄉。"
      ]
    },
    {
      "sectionIndexOrName": "11",
      "original": [
        "怨情",
        "作者：李白",
        "美人捲珠簾，深坐顰蛾眉。",
        "但見淚痕濕，不知心恨誰。"
      ]
    },
    {
      "sectionIndexOrName": "12",
      "original": [
        "八陣圖",
        "作者：杜甫",
        "功蓋三分國，名成八陣圖。",
        "江流石不轉，遺恨失吞吳。"
      ]
    },
    {
      "sectionIndexOrName": "13",
      "original": [
        "登鸛雀樓",
        "作者：王之渙",
        "白日依山盡，黃河入海流。",
        "欲窮千里目，更上一層樓。"
      ]
    },
    {
      "sectionIndexOrName": "14",
      "original": [
        "送靈澈",
        "作者：劉長卿",
        "蒼蒼竹林寺，杳杳鐘聲晚。",
        "荷笠帶斜陽，青山獨歸遠。"
      ]
    },
    {
      "sectionIndexOrName": "15",
      "original": [
        "彈琴",
        "作者：劉長卿",
        "泠泠七弦上，靜聽松風寒。",
        "古調雖自愛，今人多不彈。"
      ]
    },
    {
      "sectionIndexOrName": "16",
      "original": [
        "送上人",
        "作者：劉長卿",
        "孤雲將野鶴，豈向人間住。",
        "莫買沃洲山，時人已知處。"
      ]
    },
    {
      "sectionIndexOrName": "17",
      "original": [
        "秋夜寄邱員外",
        "作者：韋應物",
        "懷君屬秋夜，散步詠涼天。",
        "空山松子落，幽人應未眠。"
      ]
    },
    {
      "sectionIndexOrName": "18",
      "original": [
        "聽箏",
        "作者：李端",
        "鳴箏金粟柱，素手玉房前。",
        "欲得周郎顧，時時誤拂弦。"
      ]
    },
    {
      "sectionIndexOrName": "19",
      "original": [
        "新嫁娘",
        "作者：王建",
        "三日入廚下，洗手作羹湯。",
        "未諳姑食性，先遣小姑嚐。"
      ]
    },
    {
      "sectionIndexOrName": "20",
      "original": [
        "玉臺體",
        "作者：權德輿",
        "昨夜裙帶解，今朝蟢子飛。",
        "鉛華不可棄，莫是藁砧歸。"
      ]
    },
