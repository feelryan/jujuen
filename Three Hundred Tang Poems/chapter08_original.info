{
  "totalSectionNumber": 51,
  "sections": [
    {
      "sectionIndexOrName": "1",
      "original": [
        "回鄉偶書",
        "作者：賀知章",
        "少小離家老大回，鄉音無改鬢毛衰。",
        "兒童相見不相識，笑問客從何處來。"
      ]
    },
    {
      "sectionIndexOrName": "2",
      "original": [
        "桃花溪",
        "作者：張旭",
        "隱隱飛橋隔野煙，石磯西畔問漁船。",
        "桃花盡日隨流水，洞在清溪何處邊。"
      ]
    },
    {
      "sectionIndexOrName": "3",
      "original": [
        "九月九日憶山東兄弟",
        "作者：王維",
        "獨在異鄉為異客，每逢佳節倍思親。",
        "遙知兄弟登高處，遍插茱萸少一人。"
      ]
    },
    {
      "sectionIndexOrName": "4",
      "original": [
        "芙蓉樓送辛漸",
        "作者：王昌齡",
        "寒雨連江夜入吳，平明送客楚山孤。",
        "洛陽親友如相問，一片冰心在玉壺。"
      ]
    },
    {
      "sectionIndexOrName": "5",
      "original": [
        "閨怨",
        "作者：王昌齡",
        "閨中少婦不知愁，春日凝妝上翠樓。",
        "忽見陌頭楊柳色，悔教夫婿覓封侯。"
      ]
    },
    {
      "sectionIndexOrName": "6",
      "original": [
        "春宮曲",
        "王昌齡",
        "昨夜風開露井桃，未央前殿月輪高。",
        "平陽歌舞新承寵，簾外春寒賜錦袍。"
      ]
    },
    {
      "sectionIndexOrName": "7",
      "original": [
        "涼州詞",
        "王翰",
        "葡萄美酒夜光杯，欲飲琵琶馬上催。",
        "醉臥沙場君莫笑，古來征戰幾人回。"
      ]
    },
    {
      "sectionIndexOrName": "8",
      "original": [
        "送孟浩然之廣陵",
        "李白",
        "故人西辭黃鶴樓，煙花三月下揚州。",
        "孤帆遠影碧空盡，唯見長江天際流。"
      ]
    },
    {
      "sectionIndexOrName": "9",
      "original": [
        "早發白帝城",
        "李白",
        "朝辭白帝彩雲間，千里江陵一日還。",
        "兩岸猿聲啼不住，輕舟已過萬重山。"
      ]
    },
    {
      "sectionIndexOrName": "10",
      "original": [
        "逢入京使",
        "岑參",
        "故園東望路漫漫，雙袖龍鍾淚不乾。",
        "馬上相逢無紙筆，憑君傳語報平安。"
      ]
    },
    {
      "sectionIndexOrName": "11",
      "original": [
        "聞王昌齡左遷龍標遙有此寄",
        "作者：李白",
        "楊花落盡子規啼，聞道龍標過五溪。",
        "我寄愁心與明月，隨君直到夜郎西。"
      ]
    },
    {
      "sectionIndexOrName": "12",
      "original": [
        "逢入京使",
        "作者：岑參",
        "故園東望路漫漫，雙袖龍鍾淚不乾。",
        "馬上相逢無紙筆，憑君傳語報平安。"
      ]
    },
    {
      "sectionIndexOrName": "13",
      "original": [
        "江南逢李龜年",
        "作者：杜甫",
        "岐王宅裏尋常見，崔九堂前幾度聞。",
        "正是江南好風景，落花時節又逢君。"
      ]
    },
    {
      "sectionIndexOrName": "14",
      "original": [
        "滁州西澗",
        "作者：韋應物",
        "獨憐幽草澗邊生，上有黃鸝深樹鳴。",
        "春潮帶雨晚來急，野渡無人舟自橫。"
      ]
    },
    {
      "sectionIndexOrName": "15",
      "original": [
        "楓橋夜泊",
        "作者：張繼",
        "月落烏啼霜滿天，江楓漁火對愁眠。",
        "姑蘇城外寒山寺，夜半鐘聲到客船。"
      ]
    },
    {
      "sectionIndexOrName": "16",
      "original": [
        "寒食",
        "作者：韓翃",
        "春城無處不飛花，寒食東風御柳斜。",
        "日暮漢宮傳蠟燭，輕煙散入五侯家。"
      ]
    },
    {
      "sectionIndexOrName": "17",
      "original": [
        "月夜",
        "作者：劉方平",
        "更深月色半人家，北斗闌干南斗斜。",
        "今夜偏知春氣暖，蟲聲新透綠窗紗。"
      ]
    },
    {
      "sectionIndexOrName": "18",
      "original": [
        "春怨",
        "作者：劉方平",
        "紗窗日落漸黃昏，金屋無人見淚痕。",
        "寂寞空庭春欲晚，梨花滿地不開門。"
      ]
    },
    {
      "sectionIndexOrName": "19",
      "original": [
        "征人怨",
        "作者：柳中庸",
        "歲歲金河復玉關，朝朝馬策與刀環。",
        "三春白雪歸青塚，萬里黃河繞黑山。"
      ]
    },
    {
      "sectionIndexOrName": "20",
      "original": [
        "宮詞",
        "作者：顧況",
        "玉樓天半起笙歌，風送宮嬪笑語和。",
        "月殿影開聞夜漏，水晶簾捲近秋河。"
      ]
    },
