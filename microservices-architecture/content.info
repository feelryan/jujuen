    },
    {
      "id": "chapter03",
      "t": "分散式資料管理與一致性",
      "en": "Distributed Data Management & Consistency",
      "description": "解決 Database-per-service 帶來的挑戰，探討 CAP 定理、最終一致性、Saga Pattern 與分散式交易（Distributed Transactions）的實作。"
    },
    {
      "id": "chapter04",
      "t": "系統韌性與容錯設計",
      "en": "Resilience, Fault Tolerance & Reliability",
      "description": "針對分散式系統的不穩定性，設計 Circuit Breaker、Retry、Bulkhead 與 Rate Limiting 機制，防止級聯故障（Cascading Failures）。"
    },
    {
      "id": "chapter05",
      "t": "API Gateway 與 Service Mesh 架構",
      "en": "API Gateway & Service Mesh Architecture",
      "description": "探討流量入口管理、Sidecar 模式、服務發現（Service Discovery）以及如何利用 Service Mesh 處理流量控制與安全性。"
    },
    {
      "id": "chapter06",
      "t": "可觀測性：監控、日誌與分散式追蹤",
      "en": "Observability: Metrics, Logging & Distributed Tracing",
      "description": "建立全鏈路追蹤（Distributed Tracing）、集中式日誌與 Metrics 系統，以便在複雜架構中快速定位效能瓶頸與錯誤根因。"
    },
    {
