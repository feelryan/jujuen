  "chapters": [
    {
      "id": "chapter01",
      "t": "設計原則與物件導向思維重構",
      "en": "SOLID Principles and OO Thinking Refined",
      "description": "超越基礎定義，深入探討 SOLID 在大型專案中的權衡（Trade-offs），以及 Composition over Inheritance 的實戰應用與邊界。"
    },
    {
      "id": "chapter02",
      "t": "現代化 GoF 模式實戰應用",
      "en": "Modern Application of GoF Patterns",
      "description": "聚焦於 Factory, Strategy, Observer, Decorator 等高頻模式，分析其在現代框架（如 Spring, React, .NET Core）源碼中的實現與變體。"
    },
    {
      "id": "chapter03",
      "t": "重構與技術債管理",
      "en": "Refactoring to Patterns and Managing Technical Debt",
      "description": "針對 Legacy Code 場景，學習如何運用設計模式漸進式重構，解耦複雜依賴（Decoupling）並提升程式碼的可測試性。"
    },
    {
      "id": "chapter04",
      "t": "併發與多執行緒模式",
      "en": "Concurrency and Multithreading Patterns",
      "description": "掌握 Producer-Consumer, Thread Pool, Future/Promise, Active Object 等模式，解決 Race Condition 與 Deadlock，提升高併發效能。"
    },
    {
      "id": "chapter05",
      "t": "架構模式與分層設計",
      "en": "Architectural Patterns and Layered Design",
      "description": "從 MVC 到 Clean Architecture、Hexagonal Architecture (Ports and Adapters)，探討如何透過分層隔離業務邏輯與基礎設施。"
    },
    {
      "id": "chapter06",
      "t": "分散式系統與微服務模式",
      "en": "Distributed Systems and Microservices Patterns",
      "description": "涵蓋 API Gateway, Sidecar, Circuit Breaker, Saga, CQRS 等模式，應對 System Design 面試中的資料一致性與服務通訊挑戰。"
    },
    {
      "id": "chapter07",
      "t": "雲原生與高可用性設計",
      "en": "Cloud-Native and High Availability Patterns",
      "description": "專注於 Retry, Throttling, Bulkhead, Leader Election 等提升系統韌性（Resilience）與容錯能力的模式。"
    },
    {
      "id": "chapter08",
      "t": "反模式與過度設計的陷阱",
      "en": "Anti-Patterns and the Pitfalls of Over-Engineering",
      "description": "辨識 God Object, Spaghetti Code 等反模式，並培養「何時不該使用模式」的判斷力，避免為了模式而模式（Over-engineering）。"
    }
  ]
}