  "chapters": [
    {
      "id": "chapter01",
      "t": "Kafka 架構與核心抽象",
      "en": "Architecture and Core Abstractions",
      "description": "深入理解 Log-structured storage、Topic/Partition 模型，以及 Kafka 如何利用 Sequential I/O 達成高吞吐量的底層原理。"
    },
    {
      "id": "chapter02",
      "t": "生產者機制與傳輸保證",
      "en": "Producer Internals and Delivery Guarantees",
      "description": "探討 Batching、Compression、Partitioning 策略，以及 acks 設定（0, 1, all）如何在延遲與資料安全性之間做取捨。"
    },
    {
      "id": "chapter03",
      "t": "消費者群組與重平衡策略",
      "en": "Consumer Groups and Rebalancing Strategies",
      "description": "解析 Consumer Group Protocol、Rebalance 觸發條件與副作用（Stop-the-world），以及 Static Membership 等進階優化。"
    },
    {
      "id": "chapter04",
      "t": "副本機制與資料耐久性",
      "en": "Replication Protocol and Data Durability",
      "description": "掌握 ISR (In-Sync Replicas)、HW (High Watermark)、LEO 機制，以及 Leader Election 過程，確保在節點故障時資料不遺失。"
    },
    {
      "id": "chapter05",
      "t": "儲存引擎與日誌管理",
      "en": "Storage Engine and Log Management",
      "description": "分析 Segment 檔案結構、Index 查找機制，以及 Log Compaction 與 Retention Policy 對磁碟空間與讀取效能的影響。"
    },
    {
      "id": "chapter06",
      "t": "交易與精確一次語義",
      "en": "Transactions and Exactly-Once Semantics (EOS)",
      "description": "理解 Idempotent Producer 與 Transactional API 原理，如何在分散式環境下達成跨 Partition 的原子寫入與 Exactly-Once 處理。"
    },
    {
      "id": "chapter07",
      "t": "效能調校與底層優化",
      "en": "Performance Tuning and Low-level Optimization",
      "description": "利用 Zero-copy、Page Cache 機制優化 I/O，以及針對 Network Threads、Request Queue 與 JVM GC 進行全鏈路效能調校。"
    },
    {
      "id": "chapter08",
      "t": "系統設計模式與應用場景",
      "en": "System Design Patterns and Use Cases",
      "description": "在 System Design 面試中應用 Kafka：Event Sourcing、CQRS、Log Aggregation，以及處理 Backpressure 與 Poison Pills 的設計模式。"
    },
    {
      "id": "chapter09",
      "t": "串流處理與生態系整合",
      "en": "Stream Processing and Ecosystem Integration",
      "description": "Kafka Connect 與 Kafka Streams 架構概觀，探討 Stateful vs Stateless 處理、Windowing 以及 KTable/KStream 的 duality。"
    },
    {
      "id": "chapter10",
      "t": "生產環境維運與監控",
      "en": "Production Operations and Observability",
      "description": "關鍵監控指標（Consumer Lag, Under-replicated Partitions）、容量規劃、跨資料中心複製（MirrorMaker 2）及 KRaft 模式遷移。"
    }
  ]
}