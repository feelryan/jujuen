  "chapters": [
    {
      "id": "chapter01",
      "t": "雲原生核心哲學與 12-Factor App",
      "en": "Cloud-Native Philosophy & The 12-Factor App",
      "description": "探討雲原生架構的定義、不可變基礎設施（Immutable Infrastructure）概念，以及如何應用 12-Factor App 原則於現代應用程式設計，這是 System Design 面試的基礎心法。"
    },
    {
      "id": "chapter02",
      "t": "微服務拆分策略與邊界設計",
      "en": "Microservices Decomposition & Boundary Design",
      "description": "結合 DDD（領域驅動設計）與 Strangler Fig 模式，學習如何正確拆解單體架構。重點在於定義服務邊界（Boundaries）以避免分散式單體（Distributed Monolith）的陷阱。"
    },
    {
      "id": "chapter03",
      "t": "容器設計模式與 Kubernetes 原語",
      "en": "Container Design Patterns & Kubernetes Primitives",
      "description": "深入 Sidecar、Ambassador、Adapter 等容器設計模式，並掌握 Kubernetes 核心資源（Pod, Deployment, StatefulSet）在生產環境中的最佳配置與資源管理。"
    },
    {
      "id": "chapter04",
      "t": "服務通訊與 Service Mesh",
      "en": "Service Communication & Service Mesh",
      "description": "比較 REST、gRPC 與 GraphQL 的適用場景，探討 Service Mesh（如 Istio, Linkerd）解決的流量管理、mTLS 與重試問題，以及何時該引入 Mesh 層。"
    },
    {
      "id": "chapter05",
      "t": "事件驅動架構與非同步處理",
      "en": "Event-Driven Architecture (EDA) & Asynchrony",
      "description": "利用 Message Queue（Kafka, RabbitMQ）解耦系統，設計 Event Sourcing 與 Pub/Sub 模型。這是解決高併發與削峰填谷（Load Leveling）的關鍵架構。"
    },
    {
      "id": "chapter06",
      "t": "分散式資料管理與一致性",
      "en": "Distributed Data Management & Consistency",
      "description": "攻克雲原生最難題：如何在微服務間維持資料一致性。涵蓋 CAP 定理實戰應用、Saga 模式、兩階段提交（2PC）的取捨與 CQRS 模式。"
    },
    {
      "id": "chapter07",
      "t": "彈性設計與容錯機制",
      "en": "Resiliency Design & Fault Tolerance",
      "description": "設計具備自我修復能力的系統。實作 Circuit Breaker（斷路器）、Rate Limiting（限流）、Bulkhead（艙壁）模式，並引入 Chaos Engineering 驗證系統強韌度。"
    },
    {
      "id": "chapter08",
      "t": "可觀測性工程",
      "en": "Observability Engineering",
      "description": "超越傳統監控，建立 Logging、Metrics、Tracing 三大支柱（OpenTelemetry）。學習如何透過分佈式追蹤快速定位跨服務的效能瓶頸與錯誤。"
    },
    {
      "id": "chapter09",
      "t": "雲原生資安：零信任與 DevSecOps",
      "en": "Cloud-Native Security: Zero Trust & DevSecOps",
      "description": "在動態環境中實踐零信任架構（Zero Trust），包含身分認證（OIDC/OAuth2）、Secret 管理（Vault）、容器映像檔掃描與供應鏈安全。"
    },
    {
      "id": "chapter10",
      "t": "現代化交付：GitOps 與漸進式部署",
      "en": "Modern Delivery: GitOps & Progressive Deployment",
      "description": "將基礎設施即程式碼（IaC）與 GitOps 結合（ArgoCD, Flux），並實作 Canary 與 Blue/Green Deployment，確保生產環境變更的穩定性與可回滾性。"
    },
    {
      "id": "chapter11",
      "t": "Serverless 與成本優化 (FinOps)",
      "en": "Serverless Architecture & FinOps",
      "description": "評估 FaaS（Function as a Service）的適用場景與冷啟動問題，並探討雲端成本優化策略，在架構設計階段即考量成本效益（Cost-aware Architecture）。"
    }
  ]
}