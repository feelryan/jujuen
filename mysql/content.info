  "chapters": [
    {
      "id": "chapter01",
      "t": "MySQL 架構與儲存引擎核心",
      "en": "Architecture and Storage Engine Internals",
      "description": "深入理解 Server Layer 與 Storage Engine Layer 分離架構，掌握 InnoDB 的 Buffer Pool、Redo/Undo Log 與 Doublewrite Buffer 運作機制。"
    },
    {
      "id": "chapter02",
      "t": "索引底層原理與進階策略",
      "en": "Advanced Indexing and B+Tree Principles",
      "description": "剖析 B+Tree 物理結構，區分 Clustered 與 Secondary Index，並掌握覆蓋索引（Covering Index）、索引下推（ICP）與最左前綴原則。"
    },
    {
      "id": "chapter03",
      "t": "交易、鎖與 MVCC 機制",
      "en": "Transactions, Locking, and MVCC",
      "description": "探討 ACID 實作、隔離層級（Isolation Levels）、Gap Lock/Next-Key Lock 造成的 Deadlock，以及 MVCC 如何實現高併發讀寫。"
    },
    {
      "id": "chapter04",
      "t": "查詢優化與執行計畫分析",
      "en": "Query Optimization and EXPLAIN Analysis",
      "description": "解讀 EXPLAIN 與 Optimizer Trace，分析查詢成本（Cost Model），優化複雜 Join、Subquery 與 Order By/Group By 的效能瓶頸。"
    },
    {
      "id": "chapter05",
      "t": "高效能 Schema 設計與資料建模",
      "en": "High-Performance Schema Design",
      "description": "針對正規化與反正規化的權衡、資料型別精準選擇（如 JSON vs Relational）、NULL 的影響及大表變更（Online DDL）策略。"
    },
    {
      "id": "chapter06",
      "t": "高可用架構與複製機制",
      "en": "High Availability and Replication",
      "description": "掌握 Binlog 格式（Row/Statement/Mixed）、GTID、半同步複製（Semi-sync），以及主從切換（Failover）與讀寫分離架構設計。"
    },
    {
      "id": "chapter07",
      "t": "擴展性設計：分庫分表與分區",
      "en": "Scaling Strategies: Sharding and Partitioning",
      "description": "應對海量資料的垂直/水平拆分策略（Sharding）、Sharding Key 選擇、分散式 ID 生成（如 Snowflake）與跨庫查詢挑戰。"
    },
    {
      "id": "chapter08",
      "t": "維運監控與參數調校",
      "en": "Operations, Monitoring, and Tuning",
      "description": "建立關鍵監控指標（Metrics）、備份與還原策略（PITR）、以及生產環境中的關鍵參數配置（如 innodb_buffer_pool_size, sync_binlog）。"
    }
  ]
}