    },
    {
      "id": "chapter04",
      "t": "寫入效能優化與吞吐量",
      "en": "Write Performance Optimization",
      "description": "分析 Bulk Processing、Refresh Interval、Buffer 設定對 indexing 速度的影響，以及如何處理高併發寫入場景。"
    },
    {
      "id": "chapter05",
      "t": "查詢效能調優與快取機制",
      "en": "Query Performance Tuning and Caching",
      "description": "精通 Filter vs. Query Context、各種 Cache (Node Query/Shard Request) 的運作原理，以及使用 Profile API 診斷慢查詢。"
    },
    {
      "id": "chapter06",
      "t": "相關性演算法與排序邏輯",
      "en": "Relevance Scoring and Ranking",
      "description": "理解 TF-IDF 與 BM25 演算法，實作 Function Score、Scripting 與自定義排序，解決複雜的搜尋相關性需求。"
    },
    {
      "id": "chapter07",
      "t": "聚合分析與大數據應用",
      "en": "Aggregations and Analytics",
      "description": "掌握 Bucket 與 Metric Aggregations 的記憶體開銷，避免 OOM 風險，並評估 ES 在即時分析場景的適用邊界。"
    },
    {
      "id": "chapter08",
      "t": "集群規劃與生命週期管理",
