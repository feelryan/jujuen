    },
    {
      "id": "chapter09",
      "t": "生產環境維運與效能調校",
      "en": "Production Operations & Performance Tuning",
      "description": "涵蓋 Slowlog 分析、Latency 監控、Kernel 參數調校 (THP, overcommit)、Big Key 處理與安全性配置 (ACL)。"
