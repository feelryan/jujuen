    {
      "id": "chapter02",
      "t": "進階資料結構與底層實作",
      "en": "Advanced Data Structures & Internal Encoding",
      "description": "剖析 SDS, Skiplist, Ziplist/Listpack 等底層實作，掌握不同資料型態的時間複雜度 (Big O) 與記憶體開銷，以利精準選型。"
    },
    {
      "id": "chapter03",
      "t": "持久化機制與資料安全",
      "en": "Persistence Mechanisms: RDB & AOF",
      "description": "比較 RDB 快照與 AOF log 的運作原理 (COW, fsync policies)，分析在災難復原與效能之間的 Trade-off。"
    },
    {
      "id": "chapter04",
      "t": "高可用性與分散式架構",
      "en": "High Availability & Distributed Architecture",
      "description": "掌握 Replication、Sentinel 自動故障轉移與 Redis Cluster 分片機制 (Hash Slots)，理解 CAP 定理在 Redis 中的體現。"
    },
    {
      "id": "chapter05",
      "t": "快取設計模式與常見陷阱",
      "en": "Caching Patterns & Common Pitfalls",
      "description": "針對 System Design 面試，探討 Cache-Aside, Write-Through 等策略，並解決 Cache Penetration, Avalanche, Stampede 與資料一致性問題。"
    },
    {
      "id": "chapter06",
      "t": "分散式鎖與併發控制",
      "en": "Distributed Locks & Concurrency Control",
      "description": "實作正確的分散式鎖 (SETNX, Redlock, Lua Scripts)，理解原子性操作、Fencing Tokens 以及在分散式系統中的安全性挑戰。"
    },
    {
      "id": "chapter07",
      "t": "記憶體管理與淘汰策略",
      "en": "Memory Management & Eviction Policies",
      "description": "深入 LRU, LFU 等淘汰演算法，理解過期刪除策略 (Lazy vs Active) 及記憶體碎片化 (Fragmentation) 處理，優化資源成本。"
    },
    {
      "id": "chapter08",
