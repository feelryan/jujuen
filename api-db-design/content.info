    {
      "id": "chapter01",
      "t": "API 架構風格與協議選擇",
      "en": "API Paradigms & Protocol Selection",
      "description": "深入比較 REST, GraphQL, gRPC 與 WebSocket 的適用場景與取捨，針對不同業務需求（如低延遲、高靈活度）做出最佳架構決策。"
    },
    {
      "id": "chapter02",
      "t": "資料庫核心原理與儲存引擎",
      "en": "Database Internals & Storage Engines",
      "description": "探討 B-Tree 與 LSM Tree 的差異、Row-oriented vs Column-oriented 儲存格式，從底層理解資料庫讀寫效能的物理限制。"
    },
    {
      "id": "chapter03",
      "t": "進階 Schema 設計與資料建模",
      "en": "Advanced Schema Design & Data Modeling",
      "description": "涵蓋關聯式資料庫正規化與反正規化的權衡，以及 NoSQL（Document, Key-Value, Wide-Column）基於 Access Pattern 的建模策略。"
    },
    {
      "id": "chapter04",
      "t": "分散式資料一致性與交易處理",
      "en": "Distributed Consistency & Transactions",
      "description": "從 ACID 到 BASE，深入 CAP 與 PACELC 定理，並掌握分散式交易模式（2PC, Saga Pattern）以解決微服務間的資料一致性問題。"
    },
    {
      "id": "chapter05",
      "t": "資料庫擴展性與分片策略",
      "en": "Database Scalability & Partitioning",
      "description": "探討 Replication（主從複製、多主複製）與 Sharding（水平分片）的實作細節，包含 Consistent Hashing 與分片鍵（Shard Key）的選擇難題。"
    },
    {
      "id": "chapter06",
      "t": "快取策略與效能優化",
      "en": "Caching Strategies & Performance Optimization",
      "description": "設計多級快取架構（Cache-Aside, Write-Through, Write-Back），解決 Cache Penetration/Stampede 問題，並精通資料庫索引優化技巧。"
    },
    {
      "id": "chapter07",
      "t": "API 可靠性與韌性設計",
      "en": "API Reliability & Resilience Patterns",
      "description": "實作 Idempotency（冪等性）以處理網路重試，並設計 Rate Limiting、Circuit Breaker 與 Bulkhead 模式來保護高併發系統。"
    },
    {
      "id": "chapter08",
      "t": "API 演進、版本控制與安全性",
      "en": "API Evolution, Versioning & Security",
      "description": "處理 Breaking Changes 與向後相容性策略，設計安全的 AuthN/AuthZ 流程（OAuth2, OIDC, JWT），以及 API Gateway 的職責劃分。"
    },
    {
      "id": "chapter09",
      "t": "複雜系統架構模式",
      "en": "Complex Architectural Patterns: CQRS & Event Sourcing",
      "description": "針對高讀寫落差或需完整稽核軌跡的場景，應用 CQRS（讀寫分離）與 Event Sourcing 模式，並處理 Eventual Consistency 的挑戰。"
    },
    {
      "id": "chapter10",
      "t": "實戰維運與無停機遷移",
      "en": "Production Readiness & Zero-downtime Migration",
      "description": "針對海量資料進行 Online Schema Migration，設計雙寫（Dual-write）遷移策略，以及建立資料庫監控與慢查詢分析機制。"
    }
  ]
