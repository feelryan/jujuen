  "chapters": [
    {
      "id": "chapter01",
      "t": "效能分析方法論與關鍵指標",
      "en": "Performance Analysis Methodology & Key Metrics",
      "description": "建立正確的效能優化心態（Stop Guessing），掌握 Latency vs Throughput、Little's Law、P99/P95 尾延遲等核心指標的商業意義與技術意涵。"
    },
    {
      "id": "chapter02",
      "t": "程式碼層級優化與 Runtime 原理",
      "en": "Code-Level Optimization & Runtime Internals",
      "description": "深入語言 Runtime（如 JVM, V8, Go Runtime），探討記憶體管理（Stack vs Heap）、Garbage Collection 調校、以及資料結構在記憶體中的佈局對效能的影響。"
    },
    {
      "id": "chapter03",
      "t": "並發模型與多執行緒效能",
      "en": "Concurrency Models & Multithreading Performance",
      "description": "分析 Thread Pool 設定、Lock Contention、Context Switching 代價，並比較不同並發模型（Thread-based vs Event-loop vs Coroutines）在實戰中的吞吐量差異。"
    },
    {
      "id": "chapter04",
      "t": "資料庫效能與查詢優化",
      "en": "Database Performance & Query Optimization",
      "description": "超越基本的 Indexing，深入 B-Tree/LSM Tree 儲存原理、Query Execution Plan 分析、鎖機制（Locking）與隔離層級對寫入效能的權衡。"
    },
    {
      "id": "chapter05",
      "t": "快取策略與一致性設計",
      "en": "Caching Strategies & Consistency Patterns",
      "description": "探討 Cache-Aside, Write-Through 等策略，解決 Cache Penetration/Stampede 問題，並在分散式環境下處理快取與資料庫的一致性挑戰。"
    },
    {
      "id": "chapter06",
      "t": "網路 I/O 模型與通訊協定",
      "en": "Network I/O Models & Communication Protocols",
      "description": "理解 Blocking vs Non-blocking I/O (NIO, Epoll)，比較 REST/JSON 與 gRPC/Protobuf 的序列化開銷，以及 Connection Pooling 的最佳實踐。"
    },
    {
      "id": "chapter07",
      "t": "分散式系統架構優化",
      "en": "Distributed System Architecture Optimization",
      "description": "針對 System Design 面試常考題，探討 Load Balancing 演算法、Database Sharding/Partitioning 策略，以及非同步處理（Message Queue）對削峰填谷的作用。"
    },
    {
      "id": "chapter08",
      "t": "可觀測性、Profiling 與追蹤",
      "en": "Observability, Profiling & Distributed Tracing",
      "description": "學習使用 Flame Graphs 分析 CPU 熱點，利用 Distributed Tracing 定位微服務延遲瓶頸，建立有效的監控儀表板與告警機制。"
    },
    {
      "id": "chapter09",
      "t": "系統韌性與容量規劃",
      "en": "System Resilience & Capacity Planning",
      "description": "設計 Rate Limiting、Circuit Breaker 與降級策略（Degradation）以防止系統過載，並進行壓力測試（Load Testing）與容量預估。"
    }
  ]
}